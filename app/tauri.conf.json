{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HoosierSDR",
  "version": "0.1.0",
  "identifier": "com.hoosiersdr.app",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HoosierSDR",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
